name: Mirror drEEM toolbox folder from GitLab to GitHub for MATLAB online

on:
  schedule:
    - cron: '0 * * * *'
  workflow_dispatch:

jobs:
  mirror-directory:
    runs-on: ubuntu-latest

    steps:
      - name: Install git-filter-repo
        run: |
          sudo apt-get update
          sudo apt-get install -y python3-pip
          pip3 install git-filter-repo

      - name: Clone GitLab repo
        run: |
          git clone https://gitlab.com/dreem/dreem-2.git repo
          cd repo
          git filter-repo --subdirectory-filter toolbox

      - name: Push to GitHub
        run: |
          cd repo
          git remote add origin https://x-access-token:${{ secrets.GH_TOKEN }}@github.com/urbanwuensch/drEEM-online.git
          git push -u origin main --force
