  - BSD-2-Clause # bundled N-Way toolbox
  - MIT   # bundled Scientific Colour Maps (Crameri)
repository-code: "https://github.com/urbanwuensch/dreem"
url: "https://dreem.openfluor.org/"
keywords:
  - dissolved organic matter
  - fluorescence
  - absorbance
  - excitation-emission matrix
  - PARAFAC
  - CDOM
  - FDOM
  - MATLAB
